{
  "manifest_version": 3,
  "name": "Vim Keys",
  "version": "0.1.2",
  "description": "Minimale Vim-Tastatursteuerung (Ersatz für Vimium C)",
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "browser_specific_settings": {
    "gecko": {
      "id": "vim-keys@firefox-extensions.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["storage", "sessions", "bookmarks", "history", "search", "clipboardRead", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["shared/keys.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/keys.js", "content/hud.js", "content/main.js", "content/hints.js", "content/find.js", "content/visual.js", "content/marks.js", "content/vomnibar.js"],
      "run_at": "document_start",
      "match_about_blank": true,
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
